ORIVIA_ENV=development
ORIVIA_HOST=0.0.0.0
ORIVIA_PORT=8000
ORIVIA_JWT_SECRET_KEY=replace-this-with-a-secret-of-at-least-32-bytes
ORIVIA_JWT_ISSUER=orivia-api
ORIVIA_ACCESS_TOKEN_TTL_SECONDS=3600
ORIVIA_ORDER_REPOSITORY=memory
ORIVIA_DATABASE_URL=postgresql://orivia:replace-with-db-password@postgres:5432/orivia
# memory para pruebas unitarias; evm exige RPC, wallet de firma y contrato desplegado.
ORIVIA_BLOCKCHAIN_BACKEND=memory
ORIVIA_BLOCKCHAIN_RPC_URL=
ORIVIA_BLOCKCHAIN_PRIVATE_KEY=
ORIVIA_BLOCKCHAIN_CONTRACT_ADDRESS=
ORIVIA_BLOCKCHAIN_CHAIN_ID=
ORIVIA_BLOCKCHAIN_TX_TIMEOUT_SECONDS=120
ORIVIA_BLOCKCHAIN_GAS_LIMIT=180000
POSTGRES_DB=orivia
POSTGRES_USER=orivia
POSTGRES_PASSWORD=replace-with-db-password
# Registro público: roles elegibles (ADMIN y ACCOUNTING se ignoran siempre) y límite por IP.
ORIVIA_SELF_REGISTRATION_ROLES=BUYER,VIEWER
# Roles que se solicitan en el registro y esperan aprobación de un administrador.
ORIVIA_APPROVAL_REGISTRATION_ROLES=OPERATOR,ADMIN
ORIVIA_REGISTER_RATE_LIMIT_ENABLED=true
ORIVIA_REGISTER_RATE_LIMIT_MAX_ATTEMPTS=5
ORIVIA_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
GUNICORN_WORKERS=2
# Opcional: si no se configura, se usa el resumen determinista local.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
