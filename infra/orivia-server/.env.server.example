# Copiar como .env en el servidor. No contiene secretos reales.
ORIVIA_ENV=production
ORIVIA_HOST=0.0.0.0
ORIVIA_PORT=8000
ORIVIA_JWT_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ORIVIA_JWT_ISSUER=orivia-api
ORIVIA_ACCESS_TOKEN_TTL_SECONDS=3600
ORIVIA_REFRESH_TOKEN_TTL_SECONDS=2592000
ORIVIA_ORDER_REPOSITORY=postgres
ORIVIA_DATABASE_URL=postgresql://orivia:replace-with-db-password@postgres:5432/orivia
POSTGRES_DB=orivia
POSTGRES_USER=orivia
POSTGRES_PASSWORD=replace-with-db-password
GUNICORN_WORKERS=2
