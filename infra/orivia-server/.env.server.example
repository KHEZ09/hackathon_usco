# Copiar como .env en el servidor. No contiene secretos reales.
ORIVIA_ENV=production
ORIVIA_HOST=0.0.0.0
ORIVIA_PORT=8000
ORIVIA_JWT_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ORIVIA_JWT_ISSUER=orivia-api
ORIVIA_ACCESS_TOKEN_TTL_SECONDS=3600
ORIVIA_REFRESH_TOKEN_TTL_SECONDS=2592000
ORIVIA_ORDER_REPOSITORY=postgres
ORIVIA_DATABASE_URL=postgresql://orivia:replace-with-db-password@postgres:5432/orivia
# Red pública EVM (Polygon Amoy/Sepolia u otra compatible). No versionar valores reales.
ORIVIA_BLOCKCHAIN_BACKEND=evm
ORIVIA_BLOCKCHAIN_RPC_URL=https://replace-with-rpc.example
ORIVIA_BLOCKCHAIN_PRIVATE_KEY=replace-with-a-dedicated-signer-key
ORIVIA_BLOCKCHAIN_CONTRACT_ADDRESS=0xreplace-with-deployed-registry
ORIVIA_BLOCKCHAIN_CHAIN_ID=80002
ORIVIA_BLOCKCHAIN_TX_TIMEOUT_SECONDS=120
ORIVIA_BLOCKCHAIN_GAS_LIMIT=180000
POSTGRES_DB=orivia
POSTGRES_USER=orivia
POSTGRES_PASSWORD=replace-with-db-password
GUNICORN_WORKERS=2
# Orígenes explícitos del frontend. No usar '*' en producción.
ORIVIA_CORS_ORIGINS=https://app.example.com
# Protección local por proceso para intentos fallidos de login.
ORIVIA_LOGIN_RATE_LIMIT_ENABLED=true
ORIVIA_LOGIN_RATE_LIMIT_MAX_FAILURES=5
ORIVIA_LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
ORIVIA_LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
