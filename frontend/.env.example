# URL pública del backend Flask. No incluir contraseñas, tokens ni API keys.
NEXT_PUBLIC_ORIVIA_API_URL=http://localhost:8000/api/v1
# Producción: NEXT_PUBLIC_ORIVIA_API_URL=https://oriviaurlapi.tobaru.xyz/api/v1

# Solo para una demostración aislada sin backend. Mantener desactivado para la entrega.
NEXT_PUBLIC_ORIVIA_DEMO_MODE=false

# Sitio público al que apuntan los códigos QR (nunca localhost).
NEXT_PUBLIC_SITE_URL=https://orivia.tobaru.xyz
